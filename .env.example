# ---------------------------------------------------------------------------
# Horizon configuration — copy to `.env` and fill in whatever you have.
# EVERYTHING below is optional. With an empty .env, Horizon still works using
# Open-Meteo + Skyfield + a built-in template narrator.
# ---------------------------------------------------------------------------

# --- Location / cache ---
CACHE_DIR=.cache
DEFAULT_LATITUDE=17.3850
DEFAULT_LONGITUDE=78.4867
DEFAULT_LOCATION_NAME=Hyderabad, India
# Reverse-geocode GPS coordinates to a real village/suburb name (free, key-less).
REVERSE_GEOCODE_ENABLED=true

# --- Gemma / open-weight LLM (Best Use of Gemma) ---
# auto | ollama | openrouter | google | huggingface | none
LLM_PROVIDER=auto
# Local Ollama (recommended: fully open, free, private)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
# Hosted fallbacks (set one if you don't run Ollama)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-3-27b-it
GOOGLE_API_KEY=
GOOGLE_MODEL=gemma-3-27b-it
HF_API_KEY=
HF_MODEL=google/gemma-3-27b-it

# --- ElevenLabs (Best Use of ElevenLabs) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- SerpApi (Best Use of SerpApi) ---
SERPAPI_API_KEY=

# --- MongoDB Atlas (Best Use of MongoDB Atlas) ---
MONGODB_URI=
MONGODB_DB=horizon

# --- Sentry (Best Use of Sentry) ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_ENVIRONMENT=development
